{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(chapters/*.md)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python build.py >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-generated.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Handbook repo. Never edit build/handbook.html - it is generated. House rules and callout semantics are in CLAUDE.md; re-read before writing prose.'"
          }
        ]
      }
    ]
  }
}
